{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iracalculator",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    {
      "pattern": "iracalculator.online",
      "custom_domain": true
    },
    {
      "pattern": "www.iracalculator.online",
      "custom_domain": true
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
